const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

// API Endpoint สำหรับรอรับข้อมูลจาก ESP32
app.post('/api/upload-sensor', async (req, res) => {
    const { device_id, temperature, humidity, pressure } = req.body;

    console.log(`📥 ได้รับข้อมูลจาก ESP32 [${device_id}] -> Temp: ${temperature}°C, Hum: ${humidity}%`);

    // บันทึกลงตาราง environmental_logs ใน Supabase
    const { data, error } = await supabase
        .from('environmental_logs')
        .insert([{ device_id, temperature, humidity, pressure }]);

    if (error) {
        console.error('❌ บันทึกลง Supabase ไม่สำเร็จ:', error);
        return res.status(500).json({ success: false, error: error.message });
    }

    console.log('✅ บันทึกลง Supabase สำเร็จ!');
    res.status(200).json({ success: true, data });
});

// รันเซิร์ฟเวอร์ที่พอร์ต 3000
